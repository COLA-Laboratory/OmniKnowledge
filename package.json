{
  "name": "omniknowledge-site",
  "private": true,
  "type": "module",
  "description": "Checks and tools for the OmniKnowledge project page. The page itself has no dependency and no build.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node tools/serve.mjs",
    "lint": "eslint . --max-warnings 0 && stylelint \"**/*.css\" --max-warnings 0 && html-validate index.html && node tools/check-static.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "layouts": "node tools/layouts.mjs",
    "compare": "node tools/compare.mjs",
    "shot": "node tools/shot.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/pngjs": "6.0.5",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "html-validate": "11.16.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
